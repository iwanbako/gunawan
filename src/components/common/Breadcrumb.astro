---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items = [] } = Astro.props;

if (items.length === 0) return null;
---

<nav
  aria-label="Breadcrumb"
  class="relative bg-white border-b border-slate-200 overflow-hidden shadow-sm"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3">
    <ol
      class="flex items-center flex-wrap gap-1.5 text-[10px] sm:text-xs text-slate-500"
      itemscope
      itemtype="https://schema.org/BreadcrumbList"
    >
      {items.map((item, idx) => {
        const isLast = idx === items.length - 1;

        return (
          <li
            class="flex items-center gap-1.5"
            itemprop="itemListElement"
            itemscope
            itemtype="https://schema.org/ListItem"
          >
            {item.href && !isLast ? (
              <a
                href={item.href}
                class="hover:text-red-600 transition-colors font-medium text-slate-600"
                itemprop="item"
              >
                <span itemprop="name">{item.label}</span>
              </a>
            ) : (
              <span
                class={
                  isLast
                    ? "text-slate-900 font-bold"
                    : "text-slate-600 font-medium"
                }
                itemprop="name"
              >
                {item.label}
              </span>
            )}

            <meta itemprop="position" content={String(idx + 1)} />

            {!isLast && (
              <span class="text-slate-400 px-0.5" aria-hidden="true">
                /
              </span>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</nav>