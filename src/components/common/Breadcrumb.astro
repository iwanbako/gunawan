---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items = [] } = Astro.props;

if (items.length === 0) return null;
---

<nav
  aria-label="Breadcrumb"
  class="relative bg-white border-b border-slate-200 overflow-hidden shadow-sm"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3">
    <ol class="flex items-center flex-wrap gap-1.5 text-xs sm:text-sm text-slate-700 font-medium">
      {items.map((item, idx) => {
        const isLast = idx === items.length - 1;

        return (
          <li class="flex items-center gap-1.5">
            {item.href && !isLast ? (
              <a
                href={item.href}
                class="hover:text-red-600 transition-colors font-medium text-slate-700"
              >
                <span>{item.label}</span>
              </a>
            ) : (
              <span
                class={
                  isLast
                    ? "text-slate-900 font-bold"
                    : "text-slate-700 font-medium"
                }
              >
                {item.label}
              </span>
            )}

            {!isLast && (
              <span class="text-slate-500 px-0.5" aria-hidden="true">
                /
              </span>
            )}
          </li>
        );
      })}
    </ol>
  </div>
</nav>