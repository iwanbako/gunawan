---
interface Props {
  waDefault: string;
}

const { waDefault } = Astro.props;
---

<!-- Tombol Back to Top -->
<button
  id="back-to-top-btn"
  aria-label="Kembali ke atas"
  class="fixed right-4 bottom-20 md:bottom-6 z-40 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white text-red-600 shadow-xl border border-red-500 flex items-center justify-center transition-all duration-300 hover:bg-red-50 hover:border-red-600 hover:scale-105 active:scale-95 opacity-0 pointer-events-none cursor-pointer"
>
  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5 text-red-600">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
  </svg>
</button>

<!-- Floating Bottom Nav khusus Mobile -->
<div class="md:hidden fixed bottom-3 left-4 right-4 z-50 bg-white/95 backdrop-blur-md border border-red-500 rounded-2xl shadow-xl px-2 py-2">
  <div class="flex items-center justify-between gap-1">
    
    <!-- Home -->
    <a href="#" class="flex flex-col items-center justify-center flex-1 py-1 text-slate-700 active:scale-90 transition-transform hover:text-red-600 group">
      <svg class="w-4 h-4 text-slate-700 group-hover:text-red-600 transition-colors mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="text-xs font-bold text-slate-900 tracking-wide">Home</span>
    </a>

    <!-- Layanan -->
    <a href="#layanan" class="flex flex-col items-center justify-center flex-1 py-1 text-slate-700 active:scale-90 transition-transform hover:text-red-600 group">
      <svg class="w-4 h-4 text-slate-700 group-hover:text-red-600 transition-colors mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
      <span class="text-xs font-bold text-slate-900">Layanan</span>
    </a>

    <!-- Harga -->
    <a href="#harga" class="flex flex-col items-center justify-center flex-1 py-1 text-slate-700 active:scale-90 transition-transform hover:text-red-600 group">
      <svg class="w-4 h-4 text-slate-700 group-hover:text-red-600 transition-colors mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="text-xs font-bold text-slate-900">Harga</span>
    </a>

    <!-- WhatsApp -->
    <a href={waDefault} target="_blank" rel="noopener noreferrer" class="flex flex-col items-center justify-center flex-1 active:scale-90 transition-transform bg-red-600 hover:bg-red-700 text-white rounded-xl py-1.5 shadow-sm shadow-red-600/20 text-center">
      <svg class="w-4 h-4 text-white mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
      </svg>
      <span class="text-xs font-extrabold tracking-wide text-white">WhatsApp</span>
    </a>

  </div>
</div>

<script>
  const topBtn = document.getElementById("back-to-top-btn");

  window.addEventListener("scroll", () => {
    if (window.scrollY > 300) {
      topBtn?.classList.remove("opacity-0", "pointer-events-none");
      topBtn?.classList.add("opacity-100", "pointer-events-auto");
    } else {
      topBtn?.classList.add("opacity-0", "pointer-events-none");
      topBtn?.classList.remove("opacity-100", "pointer-events-auto");
    }
  });

  topBtn?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>