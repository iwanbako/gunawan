---
import { provinsiContent } from "../../data/provinsi-content";
import { getRegenciesOfProvince } from "../../lib/wilayah";

const waNumber = "6285938573419";
const waDefault = `https://wa.me/${waNumber}?text=${encodeURIComponent("Halo KerabatWeb, saya ingin konsultasi pembuatan website.")}`;

const allProvinces = Object.values(provinsiContent).sort((a, b) => 
  a.nama.localeCompare(b.nama)
);
---

<header class="sticky top-0 z-50 bg-white text-slate-900 border-b-2 border-red-600 shadow-sm">
  
  <!-- ================= TOP BAR MERAH DENGAN EFEK KETIK ================= -->
  <div class="bg-red-600 text-white text-[10px] sm:text-xs py-1.5 px-4 font-medium overflow-hidden">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2 truncate">
        <span class="bg-white text-red-700 font-bold px-1.5 py-0.5 rounded text-[9px] uppercase tracking-wider shrink-0 shadow-sm">
          Promo
        </span>
        <span id="typing-container" class="truncate">
          <span id="typing-text"></span>
          <span class="inline-block w-1.5 h-3 bg-white ml-0.5 animate-pulse"></span>
        </span>
      </div>
      <div class="hidden sm:flex items-center gap-4 shrink-0">
        <a href="mailto:halo@kerabatweb.com" class="hover:underline transition-all text-white font-medium">
          halo@kerabatweb.com
        </a>
        <span class="text-white">•</span>
        <span class="text-white font-medium">100% Bergaransi & Support Full</span>
      </div>
    </div>
  </div>

  <!-- ================= MAIN NAVBAR ================= -->
  <nav class="max-w-5xl mx-auto px-4 h-14 sm:h-16 flex items-center justify-between gap-3">
    
    <!-- LOGO -->
    <a href="/" class="group flex items-center gap-2.5 shrink-0">
      <span class="w-9 h-9 grid place-items-center rounded-xl bg-gradient-to-br from-red-600 to-red-700 text-white transition-all duration-300 group-hover:scale-105 shadow-sm active:scale-95">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" class="w-5 h-5 text-white">
          <rect width="64" height="64" rx="14" fill="#dc2626" />
          <text x="50%" y="53%" dominant-baseline="central" text-anchor="middle" fill="#ffffff" font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="48" letter-spacing="-1.5">K</text>
        </svg>
      </span>
      <span class="font-bold text-base sm:text-lg tracking-tight text-slate-900">
        Kerabat<span class="text-red-600">Web</span>
      </span>
    </a>

    <!-- MENU DESKTOP -->
    <ul class="hidden md:flex items-center justify-center gap-6 lg:gap-8 text-sm font-semibold text-slate-900 flex-1">
      <li>
        <a href="/#layanan" class="py-1.5 px-3 transition-colors hover:text-red-600">Layanan</a>
      </li>
      <li>
        <a href="/#harga" class="py-1.5 px-3 transition-colors hover:text-red-600">Harga</a>
      </li>
      
      <!-- MEGA MENU WILAYAH -->
      <li class="relative" id="wilayah-dropdown-container">
        <button 
          id="wilayah-btn"
          class="flex items-center gap-1.5 py-1.5 px-3 transition-colors hover:text-red-600 font-semibold cursor-pointer"
        >
          Wilayah
          <svg id="wilayah-arrow" class="w-3.5 h-3.5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Mega Menu Dropdown -->
        <div 
          id="wilayah-menu"
          class="absolute top-full left-1/2 -translate-x-1/2 pt-3 z-50 transition-all duration-200 invisible opacity-0 -translate-y-2 pointer-events-none"
        >
          <div class="w-[750px] bg-white text-slate-900 rounded-2xl shadow-2xl border border-red-300 flex overflow-hidden text-left h-[500px] relative">

            <!-- SISI KIRI: Daftar Provinsi -->
            <div class="w-[35%] border-r border-red-200 bg-red-50/40 flex flex-col pt-3">
              <div class="px-4 py-2 border-b border-red-200 bg-red-50">
                <span class="text-[11px] font-bold text-red-700 uppercase tracking-wider flex items-center gap-1.5">
                  Pilih Provinsi
                </span>
              </div>
              <div class="overflow-y-auto custom-scrollbar flex-1 p-2 space-y-0.5">
                {allProvinces.map((prov) => (
                  <a 
                    href={`/${prov.slug}/`}
                    data-provinsi={prov.slug}
                    class="provinsi-btn w-full text-left group flex items-center px-3.5 py-2 text-sm font-medium rounded-xl transition-all duration-150 border text-slate-800 hover:text-red-600 hover:bg-red-50/60 border-transparent hover:border-red-200 cursor-pointer"
                  >
                    <div class="w-1.5 h-1.5 rounded-full mr-2.5 bg-transparent group-hover:bg-red-600 transition-colors"></div>
                    <span class="truncate">{prov.nama}</span>
                  </a>
                ))}
              </div>
            </div>

            <!-- SISI KANAN: Daftar Kabupaten/Kota -->
            <div class="w-[65%] flex flex-col bg-white pt-3 relative">
              <div class="px-5 py-2 border-b border-red-200 flex items-center justify-between bg-white">
                <span class="text-[11px] font-bold text-slate-800 uppercase tracking-wider">
                  Kabupaten/Kota
                </span>
                <span id="selected-provinsi-badge" class="text-[11px] bg-red-50 text-red-700 px-3 py-0.5 rounded-full font-semibold border border-red-200 hidden"></span>
              </div>
              
              <div class="overflow-y-auto custom-scrollbar flex-1 p-4 relative" id="kabupaten-content-wrapper">
                {allProvinces.map((prov) => {
                  const regencies = getRegenciesOfProvince(prov.slug);
                  return (
                    <div 
                      key={prov.slug}
                      data-kab-container={prov.slug}
                      class="kab-list hidden grid grid-cols-2 gap-2"
                    >
                      {regencies.map((kab) => (
                        <a
                          href={`/${prov.slug}/${kab.slug}/`}
                          class="group flex items-center gap-2.5 px-3.5 py-2.5 text-xs sm:text-sm text-slate-900 hover:text-red-600 font-semibold rounded-xl bg-slate-50 border border-red-200 hover:border-red-400 hover:bg-red-50/50 transition-all shadow-sm"
                        >
                          <span class="truncate">{kab.name || (kab as any).nama}</span>
                        </a>
                      ))}
                    </div>
                  );
                })}

                <div id="kabupaten-placeholder" class="h-full flex flex-col items-center justify-center text-slate-700 text-sm absolute inset-0 bg-white">
                  <p class="text-center leading-relaxed font-semibold text-slate-800">Arahkan kursor ke provinsi<br/>untuk melihat kabupaten/kota.</p>
                </div>
              </div>
            </div>

          </div>
        </div>
      </li>

      <li>
        <a href="/blog/" class="py-1.5 px-3 transition-colors hover:text-red-600">Blog</a>
      </li>
      <li>
        <a href="/kontak/" class="py-1.5 px-3 transition-colors hover:text-red-600">Kontak</a>
      </li>
    </ul>

    <!-- TOMBOL WHATSAPP -->
    <a href={waDefault} target="_blank" rel="noopener noreferrer" class="bg-red-600 hover:bg-red-700 text-white font-bold px-4 sm:px-5 py-2 text-xs sm:text-sm rounded-full shrink-0 transition-all shadow-md shadow-red-600/20 active:scale-95">
      Konsultasi Gratis
    </a>
  </nav>
</header>

<script>
  // Script untuk Typing Effect & Mega Menu Dropdown
  const promoTexts = [
    "Jasa Pembuatan Website Profesional & Cepat — Mulai dari Rp 499.000 / Tahun",
    "100% Bergaransi, Hosting & Domain Gratis — Setup Cepat Siap Jualan",
    "Optimasi SEO Google & Mobile Friendly — Jangkau Pelanggan Lebih Luas",
  ];

  let textIdx = 0;
  let charIdx = 0;
  let isDeleting = false;
  const typingEl = document.getElementById("typing-text");

  function typeEffect() {
    const currentText = promoTexts[textIdx];
    if (!typingEl) return;

    if (isDeleting) {
      charIdx--;
      typingEl.textContent = currentText.substring(0, charIdx);
      if (charIdx === 0) {
        isDeleting = false;
        textIdx = (textIdx + 1) % promoTexts.length;
        setTimeout(typeEffect, 500);
        return;
      }
      setTimeout(typeEffect, 50);
    } else {
      charIdx++;
      typingEl.textContent = currentText.substring(0, charIdx);
      if (charIdx === currentText.length) {
        isDeleting = true;
        setTimeout(typeEffect, 2000);
        return;
      }
      setTimeout(typeEffect, 100);
    }
  }
  typeEffect();

  // Mega Menu Interactivity
  const wilayahBtn = document.getElementById("wilayah-btn");
  const wilayahMenu = document.getElementById("wilayah-menu");
  const wilayahArrow = document.getElementById("wilayah-arrow");
  const dropdownContainer = document.getElementById("wilayah-dropdown-container");

  let isOpen = false;
  let closeTimer: NodeJS.Timeout;

  wilayahBtn?.addEventListener("click", () => {
    isOpen = !isOpen;
    toggleMenu(isOpen);
  });

  dropdownContainer?.addEventListener("mouseenter", () => {
    clearTimeout(closeTimer);
    isOpen = true;
    toggleMenu(true);
  });

  dropdownContainer?.addEventListener("mouseleave", () => {
    closeTimer = setTimeout(() => {
      isOpen = false;
      toggleMenu(false);
    }, 200);
  });

  function toggleMenu(show: boolean) {
    if (show) {
      wilayahMenu?.classList.remove("invisible", "opacity-0", "-translate-y-2", "pointer-events-none");
      wilayahMenu?.classList.add("visible", "opacity-100", "translate-y-0", "pointer-events-auto");
      wilayahArrow?.classList.add("rotate-180");
    } else {
      wilayahMenu?.classList.add("invisible", "opacity-0", "-translate-y-2", "pointer-events-none");
      wilayahMenu?.classList.remove("visible", "opacity-100", "translate-y-0", "pointer-events-auto");
      wilayahArrow?.classList.remove("rotate-180");
    }
  }

  // Provinsi Hover Handler
  const provButtons = document.querySelectorAll(".provinsi-btn");
  const kabContainers = document.querySelectorAll(".kab-list");
  const placeholder = document.getElementById("kabupaten-placeholder");
  const badge = document.getElementById("selected-provinsi-badge");

  provButtons.forEach((btn) => {
    btn.addEventListener("mouseenter", () => {
      const slug = btn.getAttribute("data-provinsi");
      
      provButtons.forEach(b => {
        b.classList.remove("bg-red-600", "text-white", "font-semibold", "shadow-sm", "border-red-600");
        b.classList.add("text-slate-800", "hover:text-red-600", "hover:bg-red-50/60");
      });
      btn.classList.add("bg-red-600", "text-white", "font-semibold", "shadow-sm", "border-red-600");
      btn.classList.remove("text-slate-800", "hover:text-red-600", "hover:bg-red-50/60");

      kabContainers.forEach(container => {
        if (container.getAttribute("data-kab-container") === slug) {
          container.classList.remove("hidden");
        } else {
          container.classList.add("hidden");
        }
      });

      placeholder?.classList.add("hidden");
      if (badge) {
        badge.textContent = btn.textContent?.trim() || "";
        badge.classList.remove("hidden");
      }
    });
  });
</script>