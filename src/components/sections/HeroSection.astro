---
import DomainChecker from "../common/DomainChecker.astro"; // Sesuaikan path import jika diperlukan

interface Props {
  waNumber?: string;
  badge?: string;
  headline?: string;
  subheadline?: string;
  ctaText?: string;
}

const HERO_BG =
  "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=60&w=1200&auto=format&fit=crop";

const {
  waNumber = "6285938573419",
  badge = "Jasa Pembuatan Website Profesional — Online dalam 48 Jam",
  headline,
  subheadline,
  ctaText = "Konsultasi Gratis via WhatsApp",
} = Astro.props;

const getWaLink = (msg: string) =>
  `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
---

<section
  aria-labelledby="hero-heading"
  class="relative text-slate-900 overflow-hidden py-20 sm:py-28 md:py-36 flex items-center justify-center min-h-[85vh] bg-slate-100 border-b border-slate-200"
>
  <!-- ═══ BACKGROUND IMAGE ═══ -->
  <img
    src={HERO_BG}
    alt="Ilustrasi jasa pembuatan website profesional untuk bisnis"
    aria-hidden="true"
    class="absolute inset-0 z-0 w-full h-full object-cover object-center scale-105 opacity-50"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  <!-- Gradasi lembut tipis di latar belakang agar gambar tetap tampak natural -->
  <div class="absolute inset-0 z-10 bg-gradient-to-b from-white/60 via-transparent to-white/70"></div>

  <!-- ═══ KONTEN UTAMA ═══ -->
  <div class="relative z-20 w-full max-w-5xl mx-auto px-4 sm:px-6 flex flex-col items-center text-center">

    <!-- BADGE -->
    <div class="mb-4 inline-block">
      <span class="inline-block text-xs font-bold uppercase tracking-wider bg-white/90 backdrop-blur-sm border border-red-200 text-red-700 px-4 py-1.5 rounded-full shadow-sm">
        {badge}
      </span>
    </div>

    <!-- H1 — SEO-FRIENDLY & INSTANT RENDER -->
    <h1
      id="hero-heading"
      class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight tracking-tight max-w-4xl mx-auto mb-4 text-slate-900 drop-shadow-sm"
    >
      {headline ? headline : (
        <>
          <span class="text-red-600">
            Jasa Pembuatan Website
          </span>{" "}
          Profesional, Cepat, dan SEO Friendly untuk Bisnis Anda
        </>
      )}
    </h1>

    <!-- SUBHEADLINE -->
    <p class="text-sm sm:text-base md:text-lg text-slate-800 font-semibold leading-relaxed max-w-2xl mx-auto mb-8 drop-shadow-sm">
      {subheadline ??
        "Jasa website profesional dengan desain modern, performa cepat, dan optimasi SEO. Website siap konversi untuk UMKM, startup, hingga korporasi — bergaransi dan siap tingkatkan penjualan Anda."}
    </p>

    <!-- CTA BUTTONS -->
    <div class="flex flex-col sm:flex-row gap-3.5 w-full sm:w-auto justify-center mb-10">
      <a
        href={getWaLink(
          "Halo KerabatWeb, saya tertarik konsultasi jasa pembuatan website profesional."
        )}
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-3.5 rounded-full bg-red-600 hover:bg-red-700 text-white text-sm sm:text-base font-bold text-center shadow-lg shadow-red-600/20 transition-all duration-200 hover:scale-[1.02] active:scale-95"
      >
        {ctaText}
      </a>
      <a
        href="#harga"
        class="px-8 py-3.5 rounded-full bg-white/90 backdrop-blur-sm border border-slate-300 text-slate-900 hover:bg-white font-semibold text-center shadow-sm transition-all duration-200 hover:scale-[1.02] active:scale-95 text-sm sm:text-base"
      >
        Lihat Paket Harga Jasa Website
      </a>
    </div>

    <!-- DOMAIN CHECKER -->
    <div class="w-full">
      <DomainChecker />
    </div>

  </div>
</section>