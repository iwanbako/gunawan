---
interface Regency {
  name: string;
  slug: string;
}

interface Props {
  provinsiName: string;
  provinsiSlug: string;
  regencies: Regency[];
}

const { provinsiName, provinsiSlug, regencies } = Astro.props;

if (!regencies || regencies.length === 0) {
  return null;
}
---

<section class="relative bg-white py-12 sm:py-16 border-b border-slate-200 overflow-hidden">
  <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6">
    <!-- Header Compact -->
    <div class="text-center mb-6 sm:mb-8">
      <span class="inline-block text-[9px] sm:text-[10px] font-bold uppercase tracking-wider bg-red-50 border border-red-200 text-red-700 px-3.5 py-1 rounded-full mb-3 shadow-sm">
        Cakupan Layanan
      </span>

      <h2 class="text-lg sm:text-xl md:text-2xl font-extrabold text-slate-900 tracking-tight leading-tight">
        Melayani Seluruh Kabupaten/Kota di <span class="text-red-600">{provinsiName}</span>
      </h2>

      <p class="mt-2 text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed font-normal">
        {regencies.length} kabupaten/kota di {provinsiName} — semua
        terlayani 100% online tanpa biaya tambahan.
      </p>
    </div>

    <!-- Chip Kecil Semua Kabupaten menggunakan tag a -->
    <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2">
      {regencies.map((regency) => (
        <a
          href={`/${provinsiSlug}/${regency.slug}`}
          class="inline-block bg-white border border-slate-200 rounded-lg px-2.5 py-1.5 sm:px-3 sm:py-2 text-[10px] sm:text-xs text-slate-700 font-medium leading-none hover:border-red-300 hover:bg-red-50 hover:text-red-700 transition-all whitespace-nowrap shadow-sm"
          title={`Jasa Pembuatan Website ${regency.name}`}
        >
          {regency.name}
        </a>
      ))}
    </div>

    <!-- Footer Minimal -->
    <p class="text-center text-xs text-slate-500 mt-6 max-w-xl mx-auto font-normal">
      Tidak menemukan wilayah Anda?{" "}
      <span class="text-slate-900 font-semibold">
        Tetap bisa konsultasi gratis
      </span>{" "}
      — melayani seluruh Indonesia.
    </p>
  </div>
</section>