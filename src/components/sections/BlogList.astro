---
type BlogPost = {
  slug: string;
  title: string;
  excerpt: string;
  image: string;
  date: string;
  isoDate: string;
  author: string;
  content: string;
  keywords?: string[];
};

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;

function getReadingTime(html: string): number {
  const text = html.replace(/<[^>]*>/g, " ");
  const words = text.trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
}

const INITIAL_COUNT = 6;
const LOAD_STEP = 6;
---

{posts.length === 0 ? (
  <div class="text-center py-16 sm:py-20 border border-dashed border-slate-300 rounded-2xl bg-white shadow-sm">
    <p class="text-slate-600 text-sm sm:text-base px-4">
      Belum ada artikel yang dipublikasikan. Silakan kembali lagi nanti.
    </p>
  </div>
) : (
  <div id="blog-list-container" data-step={LOAD_STEP}>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {posts.map((post, index) => {
        const readingTime = getReadingTime(post.content);
        const isFirst = index === 0;
        const isHidden = index >= INITIAL_COUNT;

        return (
          <div class={`h-full blog-card ${isHidden ? "hidden" : ""}`} data-index={index}>
            <a
              href={`/blog/${post.slug}`}
              class="bg-white border border-slate-200 rounded-xl sm:rounded-2xl overflow-hidden hover:border-red-500 hover:shadow-lg transition-all duration-300 group flex flex-col h-full shadow-sm hover:-translate-y-1.5 active:scale-[0.98]"
            >
              {/* Gambar */}
              <div class="relative h-28 sm:h-48 w-full overflow-hidden bg-slate-100">
                <img
                  src={post.image}
                  alt={`Ilustrasi artikel: ${post.title}`}
                  class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500"
                  loading={isFirst ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={isFirst ? "high" : "auto"}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 to-transparent opacity-60"></div>

                {isFirst && (
                  <span class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-red-600 text-white text-[8px] sm:text-xs font-extrabold uppercase tracking-wider px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-full shadow-md">
                    Terbaru
                  </span>
                )}

                <span class="absolute bottom-2 right-2 sm:bottom-3 sm:right-3 bg-white/90 border border-slate-200 text-slate-700 text-[9px] sm:text-xs font-bold px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-full backdrop-blur-sm flex items-center gap-0.5 sm:gap-1 shadow-sm">
                  <svg
                    class="w-2.5 h-2.5 sm:w-3 sm:h-3 text-red-600"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M12 7v5l3 2"
                    />
                  </svg>
                  {readingTime}m
                </span>
              </div>

              {/* Konten */}
              <div class="p-3 sm:p-6 flex-1 flex flex-col">
                <div class="flex flex-wrap items-center gap-x-1 sm:gap-x-2 gap-y-0.5 text-[9px] sm:text-xs font-bold mb-1.5 sm:mb-2 uppercase tracking-wider">
                  <time datetime={post.isoDate} class="text-red-600 font-bold">{post.date}</time>
                  <span class="text-slate-300">•</span>
                  <span class="text-slate-500 normal-case font-semibold tracking-normal truncate max-w-[60%]">
                    {post.author}
                  </span>
                </div>

                <h2 class="text-xs sm:text-lg font-bold text-slate-900 mb-1.5 sm:mb-3 group-hover:text-red-600 transition-colors line-clamp-2 leading-snug">
                  {post.title}
                </h2>

                <p class="hidden sm:block text-xs sm:text-sm text-slate-600 line-clamp-3 mb-4 flex-1 leading-relaxed font-normal">
                  {post.excerpt}
                </p>

                {/* Kategori / Keywords dengan Desain Solid */}
                {post.keywords && post.keywords.length > 0 && (
                  <div class="hidden sm:flex flex-wrap gap-1.5 mb-4">
                    {post.keywords.slice(0, 3).map((kw) => (
                      <span
                        class="text-[11px] text-red-700 bg-red-50 border border-red-200 px-2.5 py-0.5 rounded-md font-medium shadow-sm"
                      >
                        #{kw}
                      </span>
                    ))}
                  </div>
                )}

                <span class="text-[10px] sm:text-sm font-bold text-red-600 flex items-center gap-0.5 sm:gap-1 mt-auto group-hover:underline">
                  Baca Artikel
                  <svg
                    class="w-3 h-3 sm:w-4 sm:h-4 text-red-600 group-hover:translate-x-1 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M14 5l7 7m0 0l-7 7m7-7H3"
                    />
                  </svg>
                </span>
              </div>
            </a>
          </div>
        );
      })}
    </div>

    {/* Load More Button Section */}
    <div id="load-more-wrapper" class={`mt-8 sm:mt-12 flex flex-col items-center gap-3 ${posts.length <= INITIAL_COUNT ? "hidden" : ""}`}>
      <button
        id="load-more-btn"
        type="button"
        class="w-full sm:w-auto px-8 py-3.5 bg-red-600 text-white text-sm font-extrabold rounded-full hover:bg-red-700 shadow-md shadow-red-600/20 transition-all active:scale-95 cursor-pointer"
      >
        Muat Lebih Banyak
      </button>
      <p id="load-more-info" class="text-[11px] sm:text-xs text-slate-500 font-medium" data-total={posts.length}>
        Menampilkan <span id="visible-count">{Math.min(INITIAL_COUNT, posts.length)}</span> dari {posts.length} artikel
      </p>
    </div>
  </div>
)}

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("blog-list-container");
    if (!container) return;

    const btn = document.getElementById("load-more-btn");
    const info = document.getElementById("visible-count");
    const wrapper = document.getElementById("load-more-wrapper");
    const cards = container.querySelectorAll(".blog-card");
    const step = parseInt(container.getAttribute("data-step") || "6", 10);
    const total = cards.length;

    let visibleCount = Math.min(6, total);

    if (btn && info && wrapper) {
      btn.addEventListener("click", () => {
        const nextCount = Math.min(visibleCount + step, total);
        
        for (let i = visibleCount; i < nextCount; i++) {
          (cards[i] as HTMLElement).classList.remove("hidden");
        }

        visibleCount = nextCount;
        info.textContent = visibleCount.toString();

        if (visibleCount >= total) {
          wrapper.style.display = "none";
        }
      });
    }
  });
</script>