---
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  faqs: FaqItem[];
  waNumber?: string;
}

const { faqs = [], waNumber = "6285938573419" } = Astro.props;

if (faqs.length === 0) return null;

const getWaLink = (msg: string) => `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;
---

<section class="relative bg-white border-y border-slate-200 py-16 sm:py-24 overflow-hidden">
  
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Header Section -->
    <div class="text-center mb-12 sm:mb-16">
      <span class="inline-block text-xs font-bold uppercase tracking-wider bg-red-50 border border-red-200 text-red-700 px-4 py-1.5 rounded-full mb-3 shadow-sm">
        FAQ & Tanya Jawab
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 mt-2 sm:mt-3 tracking-tight">
        Pertanyaan yang <span class="text-red-600">Sering Diajukan</span>
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-700 max-w-xl mx-auto leading-relaxed font-normal">
        Temukan jawaban lengkap seputar layanan, proses pengerjaan, dan garansi pembuatan website di KerabatWeb.
      </p>
    </div>

    <!-- List FAQ -->
    <div class="space-y-4" id="faq-accordion">
      {faqs.map((f, i) => {
        const isOpen = i === 0; // Item pertama default terbuka

        return (
          <div
            class={`faq-item rounded-2xl border transition-all duration-300 overflow-hidden shadow-sm ${
              isOpen 
                ? "bg-white border-red-400 shadow-md active" 
                : "bg-white border-slate-200 hover:border-slate-300"
            }`}
          >
            <button
              type="button"
              class="faq-btn w-full flex items-center justify-between px-5 sm:px-6 py-4 sm:py-5 cursor-pointer text-left bg-transparent hover:bg-slate-50/80 transition-colors"
            >
              <span class="font-bold text-slate-900 text-sm sm:text-base md:text-lg pr-3">
                {f.q}
              </span>
              
              <div class={`faq-icon hidden sm:flex w-8 h-8 rounded-full items-center justify-center shrink-0 font-bold transition-transform duration-300 ${
                isOpen ? "rotate-180 bg-red-600 text-white shadow-sm" : "bg-slate-100 border border-slate-300 text-slate-800"
              }`}>
                ↓
              </div>
            </button>

            <!-- Konten Jawaban dengan transisi CSS grid -->
            <div class={`faq-content grid transition-all duration-300 ease-in-out ${
              isOpen ? "grid-rows-[1fr] opacity-100" : "grid-rows-[0fr] opacity-0"
            }`}>
              <div class="overflow-hidden">
                <div class="px-5 sm:px-6 pb-5 pt-2 text-sm sm:text-base text-slate-700 leading-relaxed border-t border-slate-200 font-normal bg-white">
                  <p>{f.a}</p>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Box CTA Bawah -->
    <div class="mt-12 text-center bg-slate-50 border border-slate-200 rounded-3xl p-6 sm:p-8 relative overflow-hidden shadow-sm">
      <p class="text-sm sm:text-base text-slate-900 font-bold">
        Masih punya pertanyaan lain yang belum terjawab?
      </p>
      <a
        href={getWaLink("Halo KerabatWeb, saya ingin bertanya hal lain diluar FAQ website.")}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-red-600 hover:bg-red-700 text-white font-bold text-xs sm:text-sm transition-all shadow-md shadow-red-600/20 active:scale-95"
      >
        💬 Konsultasi Langsung via WhatsApp
      </a>
    </div>

  </div>
</section>

<script>
  const faqItems = document.querySelectorAll(".faq-item");

  faqItems.forEach((item) => {
    const btn = item.querySelector(".faq-btn");
    const content = item.querySelector(".faq-content");
    const icon = item.querySelector(".faq-icon");

    btn?.addEventListener("click", () => {
      const isActive = item.classList.contains("active");

      // Tutup semua item lain
      faqItems.forEach((otherItem) => {
        otherItem.classList.remove("active", "border-red-400", "shadow-md");
        otherItem.classList.add("border-slate-200");
        const otherContent = otherItem.querySelector(".faq-content");
        const otherIcon = otherItem.querySelector(".faq-icon");
        
        otherContent?.classList.remove("grid-rows-[1fr]", "opacity-100");
        otherContent?.classList.add("grid-rows-[0fr]", "opacity-0");
        
        if (otherIcon) {
          otherIcon.classList.remove("rotate-180", "bg-red-600", "text-white", "shadow-sm");
          otherIcon.classList.add("bg-slate-100", "border", "border-slate-300", "text-slate-800");
        }
      });

      // Jika sebelumnya tidak aktif, buka item ini
      if (!isActive) {
        item.classList.add("active", "border-red-400", "shadow-md");
        item.classList.remove("border-slate-200");
        content?.classList.remove("grid-rows-[0fr]", "opacity-0");
        content?.classList.add("grid-rows-[1fr]", "opacity-100");
        
        if (icon) {
          icon.classList.add("rotate-180", "bg-red-600", "text-white", "shadow-sm");
          icon.classList.remove("bg-slate-100", "border", "border-slate-300", "text-slate-800");
        }
      }
    });
  });
</script>