---
interface WhyUsPoint {
  title: string;
  description: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  points?: WhyUsPoint[];
}

const { title, subtitle, points } = Astro.props;

const defaultPoints: WhyUsPoint[] = [
  {
    title: "Pengerjaan Kilat 3-5 Hari",
    description:
      "Website Anda langsung online dan siap digunakan dalam hitungan hari tanpa menunggu lama.",
  },
  {
    title: "Garansi & Maintenance",
    description:
      "Sudah termasuk gratis domain, SSL, hosting, serta dukungan pemeliharaan teknis rutin.",
  },
  {
    title: "Fokus Konversi & SEO",
    description:
      "Struktur website dirancang khusus untuk meningkatkan penjualan dan mudah ditemukan di Google.",
  },
  {
    title: "Harga Transparan & Murah",
    description:
      "Tanpa biaya tersembunyi. Dapatkan fitur kelas enterprise dengan investasi yang sangat ramah di kantong.",
  },
];

const finalSubtitle =
  subtitle ??
  "Kami menghadirkan solusi pembuatan website profesional yang tidak hanya indah dipandang, tapi juga menghasilkan profit nyata untuk bisnis Anda.";

const finalPoints = points && points.length > 0 ? points : defaultPoints;
---

<section class="relative bg-white text-slate-900 py-16 sm:py-24 border-b border-slate-200 overflow-hidden">
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
    
    <!-- Header Section -->
    <div class="text-center mb-12 sm:mb-16">
      <span class="inline-block text-[10px] sm:text-xs font-bold uppercase tracking-wider bg-red-50 border border-red-200 text-red-700 px-4 py-1.5 rounded-full mb-3 shadow-sm">
        Keunggulan Kami
      </span>

      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
        {title ? (
          title
        ) : (
          <>
            Mengapa Harus{" "}
            <span class="text-red-600">
              Memilih Kami?
            </span>
          </>
        )}
      </h2>

      <p class="mt-3 text-xs sm:text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">
        {finalSubtitle}
      </p>
    </div>

    <!-- Grid Keunggulan -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- 01: Petir / Kilat -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 flex flex-col items-start transition-all duration-200 hover:border-red-400 hover:shadow-lg hover:-translate-y-1 group shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-red-50 border border-red-100 flex items-center justify-center mb-5 shadow-sm group-hover:bg-red-100 transition-colors">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-base sm:text-lg mb-2 group-hover:text-red-600 transition-colors">
          {finalPoints[0]?.title}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          {finalPoints[0]?.description}
        </p>
      </div>

      <!-- 02: Perisai / Garansi -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 flex flex-col items-start transition-all duration-200 hover:border-red-400 hover:shadow-lg hover:-translate-y-1 group shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-red-50 border border-red-100 flex items-center justify-center mb-5 shadow-sm group-hover:bg-red-100 transition-colors">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-base sm:text-lg mb-2 group-hover:text-red-600 transition-colors">
          {finalPoints[1]?.title}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          {finalPoints[1]?.description}
        </p>
      </div>

      <!-- 03: Target / SEO & Konversi -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 flex flex-col items-start transition-all duration-200 hover:border-red-400 hover:shadow-lg hover:-translate-y-1 group shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-red-50 border border-red-100 flex items-center justify-center mb-5 shadow-sm group-hover:bg-red-100 transition-colors">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 6a4 4 0 100 8 4 4 0 000-8z" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-base sm:text-lg mb-2 group-hover:text-red-600 transition-colors">
          {finalPoints[2]?.title}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          {finalPoints[2]?.description}
        </p>
      </div>

      <!-- 04: Berlian / Harga & Nilai -->
      <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 flex flex-col items-start transition-all duration-200 hover:border-red-400 hover:shadow-lg hover:-translate-y-1 group shadow-sm">
        <div class="w-12 h-12 rounded-xl bg-red-50 border border-red-100 flex items-center justify-center mb-5 shadow-sm group-hover:bg-red-100 transition-colors">
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 2L2 7l10 15L22 7l-10-5zM2 7h20M12 22V7" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-base sm:text-lg mb-2 group-hover:text-red-600 transition-colors">
          {finalPoints[3]?.title}
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
          {finalPoints[3]?.description}
        </p>
      </div>

    </div>
  </div>
</section>