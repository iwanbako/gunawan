const allProvinsi = Object.values(provinsiContent).map((p) => ({
  nama: p.nama,
  slug: p.slug,
}));

// Structured Data Schema.org JSON-LD
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "KerabatWeb",
  image: `${SITE_URL}/og-image.jpg`,
  url: SITE_URL,
  telephone: "+6285938573419",
  priceRange: "Rp 499.000 - Rp 4.500.000",
  address: {
    "@type": "PostalAddress",
    addressCountry: "ID",
  },
  description:
    "Jasa pembuatan website profesional, cepat, dan ramah SEO untuk UMKM dan perusahaan.",
  sameAs: [SITE_URL],
};

const pageTitle = "Jasa Pembuatan Website Profesional, Cepat & Ramah SEO";
const pageDescription =
  "Jasa pembuatan website landing page, company profile, dan toko online (e-commerce) bergaransi resmi. Pengerjaan kilat 3-5 hari, bebas domain & SSL, harga transparan mulai Rp 499rb.";
---

<Layout title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <HeroSection waNumber={waNumber} />
  <ServicesSection />
  <WhyUsSection />
  <GuaranteeSection />
  <TechPartners />
  <PortfolioSection />
  <TestimonialSection />
  <PricingSection pricing={pricingData} waNumber={waNumber} />
  <FaqSection faqs={faqsData} waNumber={waNumber} />

  <!-- SEMUA PROVINSI (chip kecil klik-able) -->
  <AllProvincesSection provinsiList={allProvinsi} />

  <!-- PETA AREA LAYANAN (otomatis: Indonesia di homepage) -->
  <MapSection />
</Layout>