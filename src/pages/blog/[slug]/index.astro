---
import Layout from "../../../layouts/Layout.astro";
import BlogDetail from "../../../components/sections/BlogDetail.astro"; // Sesuaikan jalur komponen BlogDetail Anda
import { blogPosts } from "../../../data/blog-posts";

const SITE_URL = "https://kerabatweb.com";

// 1. Astro Static Paths (Pengganti generateStaticParams di Next.js)
export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

// 2. Cari postingan berdasarkan slug
const post = blogPosts.find((p) => p.slug === slug);

// Jika artikel tidak ditemukan, arahkan ke halaman 404 bawaan Astro
if (!post) {
  return Astro.redirect("/404");
}

// 3. Ambil 3 artikel terkait (selain artikel saat ini)
const relatedPosts = [...blogPosts]
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => new Date(b.isoDate).getTime() - new Date(a.isoDate).getTime())
  .slice(0, 3);

// ============================================================
// HELPER: Format Tanggal ke Standar ISO 8601 (Google Schema)
// ============================================================
const formatIsoDate = (dateStr: string) => {
  if (dateStr.includes("T")) return dateStr;
  return `${dateStr}T00:00:00+07:00`; // Waktu Indonesia Barat
};

const validDatePublished = formatIsoDate(post.isoDate);
const validDateModified = formatIsoDate(post.isoDate);
const imageUrl = post.image || `${SITE_URL}/og-image.jpg`;
const pageUrl = `${SITE_URL}/blog/${post.slug}/`;

// ============================================================
// SCHEMA: BLOG POSTING & BREADCRUMB (JSON-LD)
// ============================================================
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  image: {
    "@type": "ImageObject",
    url: imageUrl,
    width: 1200,
    height: 630,
  },
  datePublished: validDatePublished,
  dateModified: validDateModified,
  author: {
    "@type": "Person",
    name: post.author,
    url: `${SITE_URL}/tentang-kami`,
  },
  publisher: {
    "@type": "Organization",
    name: "KerabatWeb",
    logo: {
      "@type": "ImageObject",
      url: `${SITE_URL}/web-app-manifest-192x192.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": pageUrl,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Beranda",
      item: SITE_URL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: `${SITE_URL}/blog`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.title,
      item: pageUrl,
    },
  ],
};

// Gabungkan Schema ke dalam array JSON-LD
const jsonLdData = [articleSchema, breadcrumbSchema];
---

<Layout
  title={post.title}
  description={post.excerpt}
  image={imageUrl}
  canonicalURL={pageUrl}
  jsonLd={jsonLdData}
>
  <div class="bg-white text-slate-900 flex flex-col min-h-screen">
    <BlogDetail post={post} relatedPosts={relatedPosts} />
  </div>
</Layout>