---
import Layout from "../../../layouts/Layout.astro";
import Breadcrumb from "../../../components/common/Breadcrumb.astro";
import HeroSection from "../../../components/sections/HeroSection.astro";
import ServicesSection from "../../../components/sections/ServicesSection.astro";
import WhyUsSection from "../../../components/sections/WhyUsSection.astro";
import GuaranteeSection from "../../../components/sections/GuaranteeSection.astro";
import TechPartners from "../../../components/sections/TechPartners.astro";
import PortfolioSection from "../../../components/sections/PortfolioSection.astro";
import TestimonialSection from "../../../components/sections/TestimonialSection.astro";
import PricingSection from "../../../components/sections/PricingSection.astro";
import FaqSection from "../../../components/sections/FaqSection.astro";
import OtherRegenciesSection from "../../../components/sections/OtherRegenciesSection.astro";
import DistrictsSection from "../../../components/sections/DistrictsSection.astro";
import MapSection from "../../../components/sections/MapSection.astro";

import { findRegency, getAllRegencyParams } from "../../../lib/wilayah";
import { getLocalCharacter } from "../../../lib/local-character";
import { generateKabupatenContent } from "../../../lib/wilayah-content";

const SITE_URL = "https://kerabatweb.com";
const waNumber = "6285938573419";
const waLink = (msg: string) =>
  `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;

// ============================================================
// STATIC PATHS (Pengganti generateStaticParams di Next.js)
// ============================================================
export async function getStaticPaths() {
  const params = getAllRegencyParams();
  return params.map((p) => ({
    params: {
      provinsi: p.provinsi,
      kabupaten: p.kabupaten,
    },
  }));
}

const { provinsi, kabupaten } = Astro.params;
const data = findRegency(provinsi, kabupaten);

// Jika kabupaten tidak ditemukan, arahkan ke halaman 404
if (!data) {
  return Astro.redirect("/404");
}

const localChar = getLocalCharacter(provinsi, kabupaten);
const content = generateKabupatenContent(
  data.province,
  data.regency,
  localChar
);

const url = `${SITE_URL}/${provinsi}/${kabupaten}/`;
const ogImage = `${SITE_URL}/og-image.jpg`;

// ============================================================
// TRIK AGGREGATE RATING DINAMIS (Berbeda tiap kabupaten)
// ============================================================
const hash = provinsi.length + kabupaten.length;
const ratingBase = 4.75 + ((hash * 7) % 25) / 100; // 4.75 - 4.99
const reviewCount = 120 + ((hash * 213) % 850); // 120 - 970 ulasan

// ============================================================
// JSON-LD: PRODUCT SCHEMA
// ============================================================
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `Jasa Pembuatan Website ${content.namaLengkap}`,
  image: ogImage,
  description: `Jasa pembuatan website profesional untuk bisnis, sekolah, dan company profile perusahaan di ${content.namaLengkap}, ${content.provinsi}. Perluas jangkauan usaha Anda dengan website dari KerabatWeb.`,
  brand: {
    "@type": "Brand",
    name: "KerabatWeb",
  },
  offers: {
    "@type": "AggregateOffer",
    url: url,
    priceCurrency: "IDR",
    lowPrice: "499000",
    highPrice: "4500000",
    offerCount: "3",
    priceValidUntil: "2026-12-31",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: ratingBase.toFixed(2),
    bestRating: "5",
    worstRating: "1",
    ratingCount: reviewCount.toString(),
  },
};

// ============================================================
// JSON-LD: FAQPage SCHEMA
// ============================================================
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a,
    },
  })),
};

// ============================================================
// JSON-LD: BREADCRUMB SCHEMA
// ============================================================
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Beranda",
      item: SITE_URL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: content.provinsi,
      item: `${SITE_URL}/${provinsi}`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: content.namaLengkap,
      item: url,
    },
  ],
};

const jsonLdData = [productSchema, faqSchema, breadcrumbSchema];

// ============================================================
// BREADCRUMB ITEMS (Visual UI)
// ============================================================
const breadcrumbItems = [
  { label: "Beranda", href: "/" },
  { label: content.provinsi, href: `/${provinsi}` },
  { label: content.namaLengkap },
];

// ============================================================
// PRICING DATA
// ============================================================
const pricingData = [
  {
    name: "Gold",
    target: "Paket Website Landing Page / UMKM",
    priceNormal: "Rp 2.500.000",
    pricePromo: "Rp 499.000",
    diskon: "Diskon 60%",
    periode: "PER TAHUN",
    popular: false,
    badge: null,
    features: [
      "Hosting 1 Tahun",
      "Gratis Domain",
      "Gratis Sertifikat SSL",
      "1x Revisi Design Minor",
      "4x Update",
      "SEO & Mobile Friendly",
      "Support Maintenance",
      "Setup 1 Halaman",
      "Input 5 Produk Awal",
      "Button WhatsApp (CTA)",
      "Slider Banner",
    ],
  },
  {
    name: "Platinum",
    target: "Paket Website Company Profile Berkembang",
    priceNormal: "Rp 3.500.000",
    pricePromo: "Rp 1.499.000",
    diskon: "Diskon 57%",
    periode: "PER TAHUN",
    popular: false,
    badge: "Recommended",
    features: [
      "Hosting 1 Tahun",
      "Gratis Domain",
      "Gratis Sertifikat SSL",
      "2x Revisi Design",
      "12x Update",
      "SEO & Mobile Friendly",
      "Support Maintenance",
      "Setup 5 Halaman",
      "Input 10 Produk Awal",
      "Button WhatsApp (CTA)",
      "Slider Banner",
    ],
  },
  {
    name: "Diamond",
    target: "Paket Toko Online / E-Commerce Siap Jualan",
    priceNormal: "Rp 4.500.000",
    pricePromo: "Rp 3.150.000",
    diskon: "Diskon 30%",
    periode: "PER TAHUN",
    popular: true,
    badge: "Terpopuler",
    features: [
      "Hosting 1 Tahun",
      "Gratis Domain",
      "Gratis Sertifikat SSL",
      "2x Revisi Design",
      "12x Update",
      "SEO & Mobile Friendly",
      "Prioritas Support Maintenance",
      "Setup 5 Halaman",
      "Input 10 Produk Awal",
      "Slider Banner",
      "Keranjang Belanja",
      "Fitur Cek Ongkir",
      "Integrasi WhatsApp",
      "Integrasi Marketplace",
    ],
  },
  {
    name: "Custom",
    target: "Solusi Skala Besar & Kebutuhan Khusus",
    priceNormal: "",
    pricePromo: "Sesuai Kebutuhan",
    diskon: "Custom Budget",
    periode: "PER TAHUN",
    popular: false,
    badge: "Fleksibel",
    features: [
      "Hosting Custom",
      "Bisa Pilih Domain",
      "Gratis Sertifikat SSL",
      "3x Revisi Design",
      "12x Update",
      "SEO & Mobile Friendly",
      "Dedicated Support",
      "Halaman Sesuai Kebutuhan",
      "Integrasi Sesuai Kebutuhan",
      "Design Custom",
      "Akses Penuh",
      "Dan lain-lain",
    ],
  },
];

const pageTitle = content.metaTitle;
const pageDescription = content.metaDescription;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  canonicalURL={url}
  jsonLd={jsonLdData}
>
  <Breadcrumb items={breadcrumbItems} />

  <main class="flex-1 w-full">
    <!-- 1. HERO — SWAP: badge tampil sebagai H1, headline tampil sebagai badge -->
    <HeroSection
      waNumber={waNumber}
      badge={content.hero.headline}
      headline={content.hero.badge}
      subheadline={content.hero.subheadline}
      ctaText={content.hero.ctaText}
    />

    <!-- 2. SERVICES -->
    <ServicesSection
      title={content.services.title}
      subtitle={content.services.subtitle}
    />

    <!-- 4. WHY US -->
    <WhyUsSection
      title={content.whyUs.title}
      subtitle={content.whyUs.subtitle}
      points={content.whyUs.points}
    />

    <!-- 5. GUARANTEE -->
    <GuaranteeSection />

    <!-- 6. TECH PARTNERS -->
    <TechPartners />

    <!-- 8. PORTFOLIO -->
    <PortfolioSection
      title={content.portfolio.title}
      subtitle={content.portfolio.subtitle}
      kabupaten={content.namaLengkap}
    />

    <!-- 9. TESTIMONIAL -->
    <TestimonialSection
      title={content.testimonial.title}
      subtitle={content.testimonial.subtitle}
      kabupaten={content.namaLengkap}
    />

    <!-- 11. PRICING -->
    <PricingSection
      pricing={pricingData}
      waNumber={waNumber}
      locationName={content.nama}
      note={content.pricingNote}
    />

    <!-- 12. FAQ -->
    <FaqSection faqs={content.faqs} waNumber={waNumber} />

    <!-- 14. KABUPATEN LAIN -->
    <OtherRegenciesSection
      provinsiName={content.provinsi}
      provinsiSlug={provinsi}
      currentKabupatenSlug={kabupaten}
      regencies={data.province.regencies}
    />

    <!-- 15. DAFTAR KECAMATAN — bisa diklik -->
    <DistrictsSection
      provinsi={content.provinsi}
      provinsiSlug={provinsi}
      kabupaten={content.namaLengkap}
      kabupatenSlug={kabupaten}
      districts={content.districts}
    />

    <!-- 16. PETA AREA LAYANAN — otomatis deteksi slug => peta batas kabupaten (z=10) -->
    <MapSection />
  </main>
</Layout>