---
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumb from "../../../../components/common/Breadcrumb.astro";
import HeroSection from "../../../../components/sections/HeroSection.astro";
import ServicesSection from "../../../../components/sections/ServicesSection.astro";
import GuaranteeSection from "../../../../components/sections/GuaranteeSection.astro";
import TechPartners from "../../../../components/sections/TechPartners.astro";
import PortfolioSection from "../../../../components/sections/PortfolioSection.astro";
import TestimonialSection from "../../../../components/sections/TestimonialSection.astro";
import PricingSection from "../../../../components/sections/PricingSection.astro";
import FaqSection from "../../../../components/sections/FaqSection.astro";
import OtherDistrictsSection from "../../../../components/sections/OtherDistrictsSection.astro";
import MapSection from "../../../../components/sections/MapSection.astro";

import { findDistrict, getAllDistrictParams } from "../../../../lib/wilayah";
import { generateKecamatanContent } from "../../../../lib/kecamatan-content";

const SITE_URL = "https://kerabatweb.com";
const waNumber = "6285938573419";
const waLink = (msg: string) =>
  `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;

// ============================================================
// STATIC PATHS (Pengganti generateStaticParams di Next.js)
// ============================================================
export async function getStaticPaths() {
  const params = getAllDistrictParams();
  return params.map((p) => ({
    params: {
      provinsi: p.provinsi,
      kabupaten: p.kabupaten,
      kecamatan: p.kecamatan,
    },
  }));
}

const { provinsi, kabupaten, kecamatan } = Astro.params;
const data = findDistrict(provinsi, kabupaten, kecamatan);

// Jika kecamatan tidak ditemukan, arahkan ke halaman 404
if (!data) {
  return Astro.redirect("/404");
}

const content = generateKecamatanContent(
  data.province,
  data.regency,
  data.district.name
);

const url = `${SITE_URL}/${provinsi}/${kabupaten}/${kecamatan}/`;
const ogImage = `${SITE_URL}/og-image.jpg`;

// Aggregate rating dinamis per kecamatan
const hash = provinsi.length + kabupaten.length + kecamatan.length;
const ratingBase = 4.75 + ((hash * 7) % 25) / 100;
const reviewCount = 80 + ((hash * 213) % 500);

// JSON-LD Product
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `Jasa Pembuatan Website ${content.namaLengkap}`,
  image: ogImage,
  description: `Jasa pembuatan website profesional untuk bisnis, sekolah, dan company profile di ${content.namaLengkap}, ${content.namaKabupaten}, ${content.namaProvinsi}. Perluas jangkauan usaha Anda dengan website dari KerabatWeb.`,
  brand: { "@type": "Brand", name: "KerabatWeb" },
  offers: {
    "@type": "AggregateOffer",
    url,
    priceCurrency: "IDR",
    lowPrice: "499000",
    highPrice: "4500000",
    offerCount: "3",
    priceValidUntil: "2026-12-31",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: ratingBase.toFixed(2),
    bestRating: "5",
    worstRating: "1",
    ratingCount: reviewCount.toString(),
  },
};

// JSON-LD FAQPage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: content.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// JSON-LD Breadcrumb
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Beranda",
      item: SITE_URL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: content.namaProvinsi,
      item: `${SITE_URL}/${provinsi}`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: content.namaKabupaten,
      item: `${SITE_URL}/${provinsi}/${kabupaten}`,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: content.namaKecamatan,
      item: url,
    },
  ],
};

const jsonLdData = [productSchema, faqSchema, breadcrumbSchema];

// Breadcrumb items (Visual UI)
const breadcrumbItems = [
  { label: "Beranda", href: "/" },
  { label: content.namaProvinsi, href: `/${provinsi}` },
  { label: content.namaKabupaten, href: `/${provinsi}/${kabupaten}` },
  { label: content.namaKecamatan },
];

// ============================================================
// PRICING DATA
// ============================================================
const pricingData = [
  {
    name: "Gold",
    target: "Paket Website Landing Page / UMKM",
    priceNormal: "Rp 2.500.000",
    pricePromo: "Rp 499.000",
    diskon: "Diskon 60%",
    periode: "PER TAHUN",
    popular: false,
    badge: null,
    features: [
      "Hosting 1 Tahun",
      "Gratis Domain",
      "Gratis Sertifikat SSL",
      "1x Revisi Design Minor",
      "4x Update",
      "SEO & Mobile Friendly",
      "Support Maintenance",
      "Setup 1 Halaman",
      "Input 5 Produk Awal",
      "Button WhatsApp (CTA)",
      "Slider Banner",
    ],
  },
  {
    name: "Platinum",
    target: "Paket Website Company Profile Berkembang",
    priceNormal: "Rp 3.500.000",
    pricePromo: "Rp 1.499.000",
    diskon: "Diskon 57%",
    periode: "PER TAHUN",
    popular: false,
    badge: "Recommended",
    features: [
      "Hosting 1 Tahun",
      "Gratis Domain",
      "Gratis Sertifikat SSL",
      "2x Revisi Design",
      "12x Update",
      "SEO & Mobile Friendly",
      "Support Maintenance",
      "Setup 5 Halaman",
