---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/common/Breadcrumb.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import ServicesSection from "../../components/sections/ServicesSection.astro";
import WhyUsSection from "../../components/sections/WhyUsSection.astro";
import GuaranteeSection from "../../components/sections/GuaranteeSection.astro";
import TechPartners from "../../components/sections/TechPartners.astro";
import PortfolioSection from "../../components/sections/PortfolioSection.astro";
import TestimonialSection from "../../components/sections/TestimonialSection.astro";
import PricingSection from "../../components/sections/PricingSection.astro";
import FaqSection from "../../components/sections/FaqSection.astro";
import ProvinsiRegenciesSection from "../../components/sections/ProvinsiRegenciesSection.astro";
import MapSection from "../../components/sections/MapSection.astro";

import { provinsiContent } from "../../data/provinsi-content";
import { getRegenciesOfProvince } from "../../lib/wilayah";

const SITE_URL = "https://kerabatweb.com";
const waNumber = "6285938573419";
const waLink = (msg: string) =>
  `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;

// ------------------------------------------------------------
// Static Paths (Pengganti generateStaticParams di Next.js)
// ------------------------------------------------------------
export async function getStaticPaths() {
  return Object.keys(provinsiContent).map((slug) => ({
    params: { provinsi: slug },
  }));
}

const { provinsi } = Astro.params;
const content = provinsiContent[provinsi];

// Jika provinsi tidak ditemukan, arahkan ke 404
if (!content) {
  return Astro.redirect("/404");
}

const url = `${SITE_URL}/${provinsi}/`;

// ------------------------------------------------------------
// Kabupaten/Kota di provinsi ini
// ------------------------------------------------------------
const regencies = getRegenciesOfProvince(provinsi).map((r) => ({
  name: r.name,
  slug: r.slug,
}));

// ------------------------------------------------------------
// TRIK AGGREGATE RATING DINAMIS (Berbeda tiap provinsi)
// ------------------------------------------------------------
const ratingBase = 4.75 + ((provinsi.length * 7) % 25) / 100;
const reviewCount = 150 + ((provinsi.length * 123) % 800);

// ------------------------------------------------------------
// JSON-LD: PRODUCT SCHEMA
// ------------------------------------------------------------
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `Jasa Pembuatan Website ${content.nama}`,
  image: `${SITE_URL}/og-image.jpg`,
  description: `Jasa pembuatan website profesional untuk bisnis, sekolah, dan company profile perusahaan di ${content.nama}. Perluas jangkauan usaha Anda dengan website dari KerabatWeb.`,
  brand: {
    "@type": "Brand",
    name: "KerabatWeb",
  },
  offers: {
    "@type": "AggregateOffer",
    url: url,
    priceCurrency: "IDR",
    lowPrice: "499000",
    highPrice: "4500000",
    offerCount: "3",
    priceValidUntil: "2026-12-31",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: ratingBase.toFixed(2),
    bestRating: "5",
    worstRating: "1",
    ratingCount: reviewCount.toString(),
  },
};

// ------------------------------------------------------------
// JSON-LD: BREADCRUMB SCHEMA
// ------------------------------------------------------------
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Beranda",
      item: SITE_URL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: content.nama,
      item: url,
    },
  ],
};

const jsonLdData = [productSchema, breadcrumbSchema];

// ------------------------------------------------------------
// BREADCRUMB ITEMS (UI)
// ------------------------------------------------------------
const breadcrumbItems = [
  { label: "Beranda", href: "/" },
  { label: content.nama },
];

// ------------------------------------------------------------
// Pricing data
// ------------------------------------------------------------
const pricingData = [
  {
    name: "Gold",
    target: "Paket Website Landing Page / UMKM",
    priceNormal: "Rp 2.500.000",
    pricePromo: "Rp 499.000",
    diskon: "Diskon 60%",
    periode: "PER TAHUN",
    popular: false,
    badge: null,
    features: [
      "Hosting 1 Tahun",
      "Gratis Domain",
      "Gratis Sertifikat SSL",
      "1x Revisi Design Minor",
      "4x Update",
      "SEO & Mobile Friendly",
      "Support Maintenance",
      "Setup 1 Halaman",
      "Input 5 Produk Awal",
      "Button WhatsApp (CTA)",
      "Slider Banner",
    ],
  },
  {
    name: "Platinum",
    target: "Paket Website Company Profile Berkembang",
    priceNormal: "Rp 3.500.000",
    pricePromo: "Rp 1.499.000",
    diskon: "Diskon 57%",
    periode: "PER TAHUN",
    popular: false,
    badge: "Recommended",
    features: [
      "Hosting 1 Tahun",
      "Gratis Domain",
      "Gratis Sertifikat SSL",
      "2x Revisi Design",
      "12x Update",
      "SEO & Mobile Friendly",
      "Support Maintenance",
      "Setup 5 Halaman",
      "Input 10 Produk Awal",
      "Button WhatsApp (CTA)",
      "Slider Banner",
    ],
  },
  {
    name: "Diamond",
    target: "Paket Toko Online / E-Commerce Siap Jualan",
    priceNormal: "Rp 4.500.000",
    pricePromo: "Rp 3.150.000",
    diskon: "Diskon 30%",
    periode: "PER TAHUN",
    popular: true,
    badge: "Terpopuler",
    features: [
      "Hosting 1 Tahun",
      "Gratis Domain",
      "Gratis Sertifikat SSL",
      "2x Revisi Design",
      "12x Update",
      "SEO & Mobile Friendly",
      "Prioritas Support Maintenance",
      "Setup 5 Halaman",
      "Input 10 Produk Awal",
      "Slider Banner",
      "Keranjang Belanja",
      "Fitur Cek Ongkir",
      "Integrasi WhatsApp",
      "Integrasi Marketplace",
    ],
  },
  {
    name: "Custom",
    target: "Solusi Skala Besar & Kebutuhan Khusus",
    priceNormal: "",
    pricePromo: "Sesuai Kebutuhan",
    diskon: "Custom Budget",
    periode: "PER TAHUN",
    popular: false,
    badge: "Fleksibel",
    features: [
      "Hosting Custom",
      "Bisa Pilih Domain",
      "Gratis Sertifikat SSL",
      "3x Revisi Design",
      "12x Update",
      "SEO & Mobile Friendly",
      "Dedicated Support",
      "Halaman Sesuai Kebutuhan",
      "Integrasi Sesuai Kebutuhan",
      "Design Custom",
      "Akses Penuh",
      "Dan lain-lain",
    ],
  },
];
---

<Layout
  title={content.metaTitle}
  description={content.metaDescription}
  canonicalURL={url}
  jsonLd={jsonLdData}
>
  <Breadcrumb items={breadcrumbItems} />

  <main class="flex-1 w-full">
    <!-- HERO — SWAP: badge tampil sebagai H1, headline tampil sebagai badge -->
    <HeroSection
      waNumber={waNumber}
      badge={content.hero.headline}
      headline={content.hero.badge}
      subheadline={content.hero.subheadline}
      ctaText={content.hero.ctaText}
    />

    <ServicesSection
      title={content.services.title}
      subtitle={content.services.subtitle}
    />

    <WhyUsSection
      title={content.whyUs.title}
      subtitle={content.whyUs.subtitle}
      points={content.whyUs.points}
    />

    <GuaranteeSection />

    <TechPartners />

    <PortfolioSection
      title={content.portfolio.title}
      subtitle={content.portfolio.subtitle}
    />

    <TestimonialSection
      title={content.testimonial.title}
      subtitle={content.testimonial.subtitle}
    />

    <PricingSection
      pricing={pricingData}
      waNumber={waNumber}
      note={content.pricingNote}
    />

    <FaqSection faqs={content.faqs} waNumber={waNumber} />

    <ProvinsiRegenciesSection
      provinsiName={content.nama}
      provinsiSlug={provinsi}
      regencies={regencies}
    />

    <!-- PETA AREA LAYANAN — otomatis deteksi slug => peta batas provinsi (z=7) -->
    <MapSection />
  </main>
</Layout>