---
import Layout from "../../layouts/Layout.astro";
import FinalCtaSection from "../components/sections/FinalCtaSection.astro"; // Sesuaikan path komponen FinalCtaSection Anda

const SITE_URL = "https://kerabatweb.com";
const waNumber = "6285938573419";

const pageTitle = "Tentang Kami";
const pageDescription =
  "Kenali KerabatWeb lebih dekat. Kami adalah tim profesional yang berdedikasi membantu UMKM dan bisnis di Indonesia tampil di dunia digital dengan website cepat, aman, dan SEO-friendly.";
const pageUrl = `${SITE_URL}/tentang-kami/`;

// Schema: AboutPage / Organization
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "Tentang KerabatWeb",
  url: pageUrl,
  description: pageDescription,
  mainEntity: {
    "@type": "Organization",
    name: "KerabatWeb",
    url: SITE_URL,
    logo: `${SITE_URL}/web-app-manifest-192x192.png`,
    sameAs: [SITE_URL],
    description:
      "Jasa pembuatan website profesional, cepat, dan ramah SEO untuk UMKM dan perusahaan.",
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={pageUrl}
  jsonLd={jsonLd}
>
  <main class="flex-1 w-full bg-white text-slate-900">
    
    <!-- ================= HERO SECTION ================= -->
    <section class="py-16 sm:py-24 text-center px-4 sm:px-6 relative overflow-hidden border-b border-slate-200">
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=1920&auto=format&fit=crop')] bg-cover bg-center opacity-5"></div>
      
      <!-- Garis Aksen Merah Tipis di Atas Section -->
      <div class="absolute top-0 left-0 right-0 h-[3px] bg-red-600"></div>

      <!-- Dekorasi Background Glow Merah Halus -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[400px] bg-red-100/50 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto">
        <span class="inline-block text-xs font-bold uppercase tracking-wider bg-red-50 border border-red-200 text-red-700 px-4 py-1.5 rounded-full shadow-sm mb-4">
          Tentang Kami
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight mb-6 tracking-tight text-slate-900">
          Membantu Bisnis Anda <span class="text-red-600">Go Digital</span> Tanpa Ribet
        </h1>
        <p class="text-sm sm:text-base md:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto font-normal">
          KerabatWeb lahir dari satu visi sederhana: membuat website berkualitas tinggi bisa diakses oleh siapa saja, termasuk UMKM dan bisnis lokal di seluruh Indonesia.
        </p>
      </div>
    </section>

    <!-- ================= CERITA KAMI ================= -->
    <section class="py-16 sm:py-24 px-4 sm:px-6 bg-slate-50/50 border-b border-slate-200">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-10 md:gap-16">
        <div class="w-full md:w-1/2">
          <h2 class="text-2xl sm:text-3xl font-extrabold mb-4 tracking-tight text-slate-900">
            Lebih dari Sekadar <span class="text-red-600">Jasa Website</span>
          </h2>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-4 font-normal">
            Kami melihat banyak pemilik bisnis hebat yang memiliki produk luar biasa, tetapi kesulitan bersaing di internet karena terkendala biaya dan teknis.
          </p>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
            Itulah mengapa KerabatWeb hadir. Kami merancang sistem, proses, dan tim yang efisien agar bisa memberikan layanan kelas <em>enterprise</em> dengan harga yang sangat bersahabat untuk Anda.
          </p>
        </div>
        <div class="w-full md:w-1/2 grid grid-cols-2 gap-4">
          <div class="bg-white border border-slate-200 p-6 rounded-2xl text-center shadow-sm">
            <h3 class="text-3xl font-black text-red-600 mb-1">500+</h3>
            <p class="text-xs text-slate-600 font-medium">Proyek Selesai</p>
          </div>
          <div class="bg-white border border-slate-200 p-6 rounded-2xl text-center shadow-sm">
            <h3 class="text-3xl font-black text-red-600 mb-1">4.9/5</h3>
            <p class="text-xs text-slate-600 font-medium">Rating Klien</p>
          </div>
          <div class="bg-white border border-slate-200 p-6 rounded-2xl text-center shadow-sm">
            <h3 class="text-3xl font-black text-red-600 mb-1">99%</h3>
            <p class="text-xs text-slate-600 font-medium">Kepuasan</p>
          </div>
          <div class="bg-white border border-slate-200 p-6 rounded-2xl text-center shadow-sm">
            <h3 class="text-3xl font-black text-red-600 mb-1">100%</h3>
            <p class="text-xs text-slate-600 font-medium">Tepat Waktu</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= NILAI-NILAI KAMI ================= -->
    <section class="py-16 sm:py-24 px-4 sm:px-6 border-b border-slate-200 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-2xl sm:text-3xl font-extrabold mb-3 tracking-tight text-slate-900">
            Nilai yang Kami <span class="text-red-600">Pegang</span>
          </h2>
          <p class="text-sm text-slate-600 max-w-2xl mx-auto leading-relaxed font-normal">
            Setiap baris kode dan desain yang kami buat didasari oleh prinsip-prinsip ini.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <!-- Value 1 -->
          <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 text-center hover:border-red-500 transition-all shadow-sm group hover:shadow-md">
            <div class="w-14 h-14 mx-auto bg-red-600 rounded-2xl flex items-center justify-center text-2xl mb-5 text-white shadow-md shadow-red-600/20 font-bold">
              🤝
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900 group-hover:text-red-600 transition-colors">Jujur & Transparan</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              Tidak ada biaya tersembunyi. Semua fitur, batasan, dan estimasi waktu dijelaskan sejak awal.
            </p>
          </div>
          
          <!-- Value 2 -->
          <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 text-center hover:border-red-500 transition-all shadow-sm group hover:shadow-md">
            <div class="w-14 h-14 mx-auto bg-red-600 rounded-2xl flex items-center justify-center text-2xl mb-5 text-white shadow-md shadow-red-600/20 font-bold">
              ⚡
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900 group-hover:text-red-600 transition-colors">Fokus pada Hasil</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              Website bukan sekadar pajangan. Kami merancang website yang siap mendatangkan <em>leads</em> dan penjualan.
            </p>
          </div>

          <!-- Value 3 -->
          <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 text-center hover:border-red-500 transition-all shadow-sm group hover:shadow-md">
            <div class="w-14 h-14 mx-auto bg-red-600 rounded-2xl flex items-center justify-center text-2xl mb-5 text-white shadow-md shadow-red-600/20 font-bold">
              🛡️
            </div>
            <h3 class="text-lg font-bold mb-2 text-slate-900 group-hover:text-red-600 transition-colors">Dukungan Penuh</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
              Kami tidak lepas tangan setelah website jadi. Ada garansi dan <em>support</em> yang siap membantu Anda.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CTA SECTION ================= -->
    <FinalCtaSection 
      waNumber={waNumber}
      title="Siap Bekerja Sama dengan Tim Kami?"
      subtitle="Mari diskusikan ide dan kebutuhan website Anda. Konsultasi 100% gratis, tanpa paksaan."
    />
  </main>
</Layout>