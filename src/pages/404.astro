---
import Layout from "../layouts/Layout.astro";

const SITE_URL = "https://kerabatweb.com";
const waNumber = "6285938573419";
const waLink = (msg: string) =>
  `https://wa.me/${waNumber}?text=${encodeURIComponent(msg)}`;

const pageTitle = "Halaman Tidak Ditemukan (404) | KerabatWeb";
const pageDescription =
  "Halaman yang Anda cari tidak ditemukan. Kembali ke beranda atau hubungi kami via WhatsApp.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalURL={`${SITE_URL}/404`}
>
  <!-- Meta robots khusus untuk halaman 404 (noindex, follow) -->
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <div class="bg-white text-slate-900 flex flex-col min-h-screen relative overflow-hidden">
    
    <!-- Garis Aksen Merah Tipis di Atas Section -->
    <div class="absolute top-0 left-0 right-0 h-[3px] bg-red-600"></div>

    <!-- Dekorasi Background Glow Merah Halus -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[400px] bg-red-100/50 rounded-full blur-[120px] pointer-events-none"></div>

    <main class="flex-1 w-full flex items-center justify-center px-4 py-16 sm:py-24 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        
        <!-- Badge -->
        <span class="inline-block text-[11px] sm:text-xs font-bold uppercase tracking-wider bg-red-50 border border-red-200 text-red-700 px-4 py-1.5 rounded-full shadow-sm mb-6">
          404 - Halaman Tidak Ditemukan
        </span>

        <!-- Angka 404 Besar -->
        <div class="relative mb-6">
          <h1 class="text-[100px] sm:text-[140px] md:text-[180px] font-black leading-none text-red-600 drop-shadow-sm select-none">
            404
          </h1>
        </div>

        <!-- Headline -->
        <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold mb-4 text-slate-900 leading-tight">
          Waduh, Halaman yang Anda Cari <span class="text-red-600">Tidak Ada</span>
        </h2>

        <!-- Deskripsi -->
        <p class="text-sm sm:text-base text-slate-600 max-w-xl mx-auto mb-10 leading-relaxed font-normal">
          Mungkin URL-nya salah ketik, halaman sudah dipindahkan, atau memang
          tidak pernah ada. Tenang, Anda tidak perlu kemana-mana, langsung
          pilih salah satu opsi di bawah ini.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-12">
          <a
            href="/"
            class="bg-red-600 hover:bg-red-700 text-white font-extrabold px-6 py-3.5 rounded-xl transition-all shadow-lg shadow-red-600/20 active:scale-95 text-sm flex items-center justify-center gap-2"
          >
            🏠 Kembali ke Beranda
          </a>
          <a
            href={waLink("Halo KerabatWeb, saya tersesat di halaman 404. Bisa bantu?")}
            target="_blank"
            rel="noopener noreferrer"
            class="bg-white hover:bg-slate-50 text-slate-800 font-semibold px-6 py-3.5 rounded-xl border border-slate-300 transition-all text-sm flex items-center justify-center gap-2 shadow-sm"
          >
            💬 Chat Kami via WhatsApp
          </a>
        </div>

        <!-- Bantuan Navigasi -->
        <div class="border-t border-slate-200 pt-8">
          <p class="text-xs sm:text-sm text-slate-500 mb-4 font-semibold uppercase tracking-wider">
            Mungkin Anda Mencari:
          </p>
          <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs sm:text-sm">
            <a
              href="/#layanan"
              class="bg-white hover:bg-red-50 border border-slate-200 hover:border-red-200 text-slate-700 hover:text-red-700 px-4 py-2 rounded-lg transition-all shadow-sm font-medium"
            >
              Layanan
            </a>
            <a
              href="/#harga"
              class="bg-white hover:bg-red-50 border border-slate-200 hover:border-red-200 text-slate-700 hover:text-red-700 px-4 py-2 rounded-lg transition-all shadow-sm font-medium"
            >
              Paket Harga
            </a>
            <a
              href="/#faq"
              class="bg-white hover:bg-red-50 border border-slate-200 hover:border-red-200 text-slate-700 hover:text-red-700 px-4 py-2 rounded-lg transition-all shadow-sm font-medium"
            >
              FAQ
            </a>
            <a
              href="/aceh"
              class="bg-white hover:bg-red-50 border border-slate-200 hover:border-red-200 text-slate-700 hover:text-red-700 px-4 py-2 rounded-lg transition-all shadow-sm font-medium"
            >
              Website di Aceh
            </a>
            <a
              href="/dki-jakarta"
              class="bg-white hover:bg-red-50 border border-slate-200 hover:border-red-200 text-slate-700 hover:text-red-700 px-4 py-2 rounded-lg transition-all shadow-sm font-medium"
            >
              Website di Jakarta
            </a>
          </div>
        </div>

      </div>
    </main>
  </div>
</Layout>